<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync Controls"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle auto-sync or trigger a manual backup."
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="20dp" />

        <!-- File Sync Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📁  File Sync"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFileSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-backup photos, videos, and documents from DCIM, Pictures, Documents, and Download folders."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvFileSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Every 15 minutes  •  Streaming upload (zero RAM)"
                android:textSize="11sp"
                android:textColor="@color/accent_green"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnSyncFiles"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_green"
                android:text="⚡  SYNC FILES NOW"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- SMS Sync Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬  Comm Sync"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCommSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-backup all SMS messages, call logs, and contacts to your Supabase database."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCommSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Every 15 minutes  •  SMS + Calls + Contacts"
                android:textSize="11sp"
                android:textColor="@color/accent_cyan"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnSyncComm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_blue"
                android:text="⚡  SYNC COMMS NOW"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- WhatsApp Sync Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱  WhatsApp Sync"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWhatsappSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-backup WhatsApp chat databases, images, videos, and voice notes."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvWhatsappSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Tied to File Sync schedule  •  Zero RAM upload"
                android:textSize="11sp"
                android:textColor="@color/accent_green"
                android:layout_marginBottom="14dp" />
        </LinearLayout>

        <!-- Live Logs Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋  Live Logs"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/input_background"
                    android:text="Clear"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:minWidth="0dp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/input_background"
                    android:text="Copy"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/log_background"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for sync activity..."
                    android:textSize="11sp"
                    android:textColor="@color/accent_green"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.4" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
